{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "querycn",
  "homepage": "https://github.com/minhduoc-tran/tablecn",
  "items": [
    {
      "name": "filter-builder",
      "type": "registry:block",
      "title": "Filter Builder",
      "description": "A filter builder for data tables: field, operator and value rows applied to the URL, built on @querycn/filter-react.",
      "dependencies": [
        "@querycn/filter-core",
        "@querycn/filter-react",
        "lucide-react"
      ],
      "registryDependencies": [
        "badge",
        "button",
        "calendar",
        "input",
        "popover",
        "select"
      ],
      "files": [
        {
          "path": "registry/{base}/filter/filter-builder.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-builder.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-builder-panel.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-builder-panel.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-join-select.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-join-select.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-rule-warnings.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-rule-warnings.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-chips.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-chips.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-combobox.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-combobox.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-field-select.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-field-select.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-operator-select.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-operator-select.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-rule-row.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-rule-row.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-value-input.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-value-input.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-text-value-input.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-text-value-input.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-boolean-value-input.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-boolean-value-input.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-select-value-input.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-select-value-input.tsx"
        },
        {
          "path": "registry/{base}/filter/filter-date-value-input.tsx",
          "type": "registry:component",
          "target": "@components/filter/filter-date-value-input.tsx"
        },
        {
          "path": "registry/shared/filter/filter-date-format.ts",
          "type": "registry:lib",
          "target": "@components/filter/filter-date-format.ts"
        },
        {
          "path": "registry/shared/filter/filter-rule-summary.ts",
          "type": "registry:lib",
          "target": "@components/filter/filter-rule-summary.ts"
        }
      ],
      "bases": {
        "radix": {
          "registryDependencies": ["command"]
        },
        "base": {
          "registryDependencies": ["command"]
        },
        "aria": {
          "dependencies": ["react-aria-components", "@internationalized/date"]
        }
      }
    }
  ]
}
